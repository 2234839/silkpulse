{
  "name": "@clarosight/server",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "clarosight": "./dist/bin/clarosight.mjs"
  },
  "scripts": {
    "build": "vp pack src/index.ts --format esm --out-dir dist && vp pack bin/clarosight.ts --format esm --out-dir dist/bin",
    "dev": "vp pack src/index.ts --format esm --out-dir dist --watch",
    "start": "node dist/bin/clarosight.mjs",
    "check": "vp check"
  },
  "dependencies": {
    "@clarosight/feature-detect": "workspace:*",
    "@clarosight/shared": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
