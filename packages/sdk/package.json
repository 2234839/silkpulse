{
  "name": "@silkpulse/sdk",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts --format iife --minify --global-name SilkPulseSDK --out-dir dist",
    "dev": "vp pack src/index.ts --format iife --global-name SilkPulseSDK --out-dir dist --watch",
    "check": "vp check"
  },
  "dependencies": {
    "@silkpulse/shared": "workspace:*",
    "@vue/devtools-core": "^8.2.1",
    "@vue/devtools-kit": "^8.2.1",
    "@zumer/snapdom": "catalog:",
    "superjson": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
